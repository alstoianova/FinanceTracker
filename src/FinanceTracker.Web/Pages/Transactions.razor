@page "/transactions"
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<h1>Transactions</h1>

<div style="
    display:flex;
    gap:12px;
    margin-bottom:24px;
    flex-wrap:wrap;">

    <button
        @onclick='() => SetFilter("All")'
        style="
            padding:10px 18px;
            border:none;
            border-radius:10px;
            background:#2563eb;
            color:white;
            cursor:pointer;
            font-weight:600;">
        All
    </button>

    <button
        @onclick='() => SetFilter("Today")'
        style="
            padding:10px 18px;
            border:none;
            border-radius:10px;
            background:#2563eb;
            color:white;
            cursor:pointer;
            font-weight:600;">
        Today
    </button>

    <button
        @onclick='() => SetFilter("Week")'
        style="
            padding:10px 18px;
            border:none;
            border-radius:10px;
            background:#2563eb;
            color:white;
            cursor:pointer;
            font-weight:600;">
        Last 7 Days
    </button>

    <button
        @onclick='() => SetFilter("Month")'
        style="
            padding:10px 18px;
            border:none;
            border-radius:10px;
            background:#2563eb;
            color:white;
            cursor:pointer;
            font-weight:600;">
        This Month
    </button>

</div>

<div style="
    display:flex;
    gap:20px;
    margin-bottom:30px;
    flex-wrap:wrap;">

    <div class="summary-card" style="
        background:white;
        padding:20px;
        border-radius:12px;
        box-shadow:0 2px 8px rgba(0,0,0,0.05);
        min-width:220px;">

        <h3>Total Balance</h3>

        <h2 style="color:#2563eb;">
            @TotalBalance MDL
        </h2>

    </div>

    <div class="summary-card" style="
        background:white;
        padding:20px;
        border-radius:12px;
        box-shadow:0 2px 8px rgba(0,0,0,0.05);
        min-width:220px;">

        <h3>Total Income</h3>

        <h2 style="color:green;">
            +@TotalIncome MDL
        </h2>

    </div>

    <div class="summary-card" style="
        background:white;
        padding:20px;
        border-radius:12px;
        box-shadow:0 2px 8px rgba(0,0,0,0.05);
        min-width:220px;">

        <h3>Total Expense</h3>

        <h2 style="color:red;">
            -@TotalExpense MDL
        </h2>

    </div>

</div>

<h3>Create Transaction</h3>

<div style="margin-bottom:20px;">

    <input type="number"
           placeholder="Amount"
           @bind="newTransaction.Amount"
           style="padding:8px; margin-right:10px;" />

    <input placeholder="Description"
           @bind="newTransaction.Description"
           style="padding:8px; margin-right:10px;" />

    <br />
    <br />

    <select @bind="newTransaction.Type"
            style="padding:8px; margin-right:10px;">
        <option value="Income">Income</option>
        <option value="Expense">Expense</option>
    </select>

    <select @bind="newTransaction.AccountId"
            style="padding:8px; margin-right:10px;">

        @foreach (var account in accounts)
        {
            <option value="@account.Id">
                @account.Name
            </option>
        }

    </select>

    <select @bind="newTransaction.CategoryId"
            style="padding:8px; margin-right:10px;">

        @foreach (var category in categories)
        {
            <option value="@category.Id">
                @category.Name
            </option>
        }

    </select>

    <button @onclick="CreateTransaction"
            style="
                padding:8px 16px;
                background-color:#2563eb;
                color:white;
                border:none;
                border-radius:8px;
                cursor:pointer;">

        Create

    </button>

</div>

<hr />

<h3>Filters</h3>

<input
    type="text"
    placeholder="Search transaction..."
    @bind="searchText"
    style="
        padding:10px;
        width:250px;
        margin-bottom:20px;
        border-radius:8px;
        border:1px solid #ccc;" />

<br />

<select @bind="selectedType"
        style="padding:8px; margin-bottom:20px;">

    <option value="All">All</option>
    <option value="Income">Income</option>
    <option value="Expense">Expense</option>

</select>

<hr />

@if (transactions is null)
{
    <p>Loading...</p>
}
else
{
    @foreach (var transaction in FilteredTransactions)
    {
        <div class="transaction-card"
             @key="transaction.Id"
             style="
                border:1px solid #dcdcdc;
                border-radius:12px;
                padding:20px;
                margin-bottom:15px;
                background-color:white;
                box-shadow:0 2px 8px rgba(0,0,0,0.05);">

            <h3 style="
                color:@(transaction.Type == "Income"
                    ? "green"
                    : "red")">

                @(transaction.Type == "Income" ? "+" : "-")
                @transaction.Amount MDL

            </h3>

            <p>
                <b>Type:</b>
                @transaction.Type
            </p>

            <p>
                <b>Description:</b>
                @transaction.Description
            </p>

            <p>
                <b>Account:</b>
                @transaction.AccountName
            </p>

            <p>
                <b>Category:</b>
                @transaction.CategoryName
            </p>

            <p>
                <b>Date:</b>
                @transaction.Date.ToString("dd.MM.yyyy HH:mm")
            </p>

        </div>
    }
}

@code {

    private List<TransactionDto>? transactions;

    private List<AccountDto> accounts = new();

    private List<CategoryDto> categories = new();

    private string selectedType = "All";

    private string searchText = "";

    private string currentFilter = "All";

    private decimal TotalIncome =>
        transactions?
            .Where(t => t.Type == "Income")
            .Sum(t => t.Amount)
        ?? 0;

    private decimal TotalExpense =>
        transactions?
            .Where(t => t.Type == "Expense")
            .Sum(t => t.Amount)
        ?? 0;

    private decimal TotalBalance =>
        TotalIncome - TotalExpense;

    private List<TransactionDto> FilteredTransactions
    {
        get
        {
            if (transactions == null)
            {
                return new();
            }

            var result = transactions.AsQueryable();

            result = currentFilter switch
            {
                "Today" =>
                    result.Where(t =>
                        t.Date.Date == DateTime.Now.Date),

                "Week" =>
                    result.Where(t =>
                        t.Date >= DateTime.Now.AddDays(-7)),

                "Month" =>
                    result.Where(t =>
                        t.Date.Month == DateTime.Now.Month
                        &&
                        t.Date.Year == DateTime.Now.Year),

                _ => result
            };

            result = result.Where(t =>
                (selectedType == "All"
                 || t.Type == selectedType)

                &&

                (string.IsNullOrWhiteSpace(searchText)
                 || t.Description.Contains(
                        searchText,
                        StringComparison.OrdinalIgnoreCase)
                 || t.CategoryName.Contains(
                        searchText,
                        StringComparison.OrdinalIgnoreCase)
                 || t.AccountName.Contains(
                        searchText,
                        StringComparison.OrdinalIgnoreCase)));

            return result.ToList();
        }
    }

    private void SetFilter(string filter)
    {
        currentFilter = filter;
    }

    private CreateTransactionRequest newTransaction =
        new()
        {
            Type = "Expense",
            Date = DateTime.UtcNow
        };

    protected override async Task OnInitializedAsync()
    {
        transactions =
            await Http.GetFromJsonAsync<List<TransactionDto>>(
                "http://localhost:5228/transactions")
            ?? new();

        accounts =
            await Http.GetFromJsonAsync<List<AccountDto>>(
                "http://localhost:5228/accounts")
            ?? new();

        categories =
            await Http.GetFromJsonAsync<List<CategoryDto>>(
                "http://localhost:5228/categories")
            ?? new();
    }

    private async Task CreateTransaction()
    {
        await Http.PostAsJsonAsync(
            "http://localhost:5228/transactions",
            newTransaction);

        transactions =
            await Http.GetFromJsonAsync<List<TransactionDto>>(
                "http://localhost:5228/transactions");

        StateHasChanged();
    }

    public class TransactionDto
    {
        public Guid Id { get; set; }

        public decimal Amount { get; set; }

        public string Description { get; set; } = "";

        public string Type { get; set; } = "";

        public string AccountName { get; set; } = "";

        public string CategoryName { get; set; } = "";

        public DateTime Date { get; set; }
    }

    public class AccountDto
    {
        public Guid Id { get; set; }

        public string Name { get; set; } = "";
    }

    public class CategoryDto
    {
        public Guid Id { get; set; }

        public string Name { get; set; } = "";
    }

    public class CreateTransactionRequest
    {
        public decimal Amount { get; set; }

        public string Description { get; set; } = "";

        public string Type { get; set; } = "Expense";

        public Guid AccountId { get; set; }

        public Guid CategoryId { get; set; }

        public DateTime Date { get; set; }
    }
}