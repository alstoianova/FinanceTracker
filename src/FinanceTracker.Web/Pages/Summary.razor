@page "/summary"
@using System.Net.Http.Json
@using System.Globalization
@inject HttpClient Http

<h1>Summary</h1>

<div class="month-card" style="
    background:white;
    padding:20px;
    border-radius:12px;
    margin-top:30px;
    margin-bottom:30px;
    box-shadow:0 2px 8px rgba(0,0,0,0.05);">

    <h2>Monthly Statistics</h2>

    @foreach (var month in MonthlyStatistics)
    {
        <div style="margin-top:20px;">

            <div style="
                display:flex;
                justify-content:space-between;
                margin-bottom:6px;">

                <b>@month.Month</b>

                <span>
                    +@month.Income MDL /
                    -@month.Expense MDL
                </span>

            </div>

            <div style="
                width:100%;
                background:#ececec;
                height:18px;
                border-radius:20px;
                overflow:hidden;">

                <div style="
                    width:@month.Percent%;
                    background:#2563eb;
                    height:100%;">

                </div>

            </div>

        </div>
    }

</div>

@if (transactions == null)
{
    <p>Loading...</p>
}
else
{
    <div style="
        display:flex;
        gap:20px;
        margin-top:20px;
        flex-wrap:wrap;">

        <div class="summary-card" style="
            background:white;
            padding:20px;
            border-radius:12px;
            box-shadow:0 2px 8px rgba(0,0,0,0.05);
            min-width:220px;">

            <h3>Total Income</h3>

            <h2 style="color:green;">
                +@TotalIncome MDL
            </h2>

        </div>

        <div class="summary-card" style="
            background:white;
            padding:20px;
            border-radius:12px;
            box-shadow:0 2px 8px rgba(0,0,0,0.05);
            min-width:220px;">

            <h3>Total Expense</h3>

            <h2 style="color:red;">
                -@TotalExpense MDL
            </h2>

        </div>

        <div class="summary-card" style="
            background:white;
            padding:20px;
            border-radius:12px;
            box-shadow:0 2px 8px rgba(0,0,0,0.05);
            min-width:220px;">

            <h3>Total Balance</h3>

            <h2 style="color:#2563eb;">
                @Balance MDL
            </h2>

        </div>

    </div>

    <h2 style="margin-top:40px;">
        Expenses By Category
    </h2>

    @foreach (var category in ExpenseByCategory)
    {
        <div class="category-card" style="
            background:white;
            padding:16px;
            margin-top:12px;
            border-radius:10px;
            box-shadow:0 2px 6px rgba(0,0,0,0.05);">

            <div style="
                display:flex;
                justify-content:space-between;
                align-items:center;">

                <h3>@category.Category</h3>

                <h2 style="color:red;">
                    -@category.Total MDL
                </h2>

            </div>

            <div style="
                width:100%;
                height:18px;
                background:#e5e7eb;
                border-radius:999px;
                overflow:hidden;">

                <div style="
                    height:100%;
                    width:@($"{category.Percent}%");
                    background:#ef4444;
                    border-radius:999px;">
                </div>

            </div>

            <p style="
                margin-top:8px;
                color:gray;">
                @category.Percent%
            </p>

        </div>
    }

    <h2 style="margin-top:40px;">
        Recent Transactions
    </h2>

    @foreach (var transaction in RecentTransactions)
    {
        <div class="transaction-card" style="
            background:white;
            padding:18px;
            margin-top:14px;
            border-radius:12px;
            box-shadow:0 2px 8px rgba(0,0,0,0.05);
            display:flex;
            justify-content:space-between;
            align-items:center;">

            <div>

                <h3 style="
                    margin:0;
                    color:@(transaction.Type == "Income"
                        ? "green"
                        : "red")">

                    @(transaction.Type == "Income"
                        ? "+"
                        : "-")
                    @transaction.Amount MDL

                </h3>

                <p style="margin:4px 0;">
                    @transaction.Description
                </p>

                <small style="color:gray;">
                    @transaction.CategoryName
                </small>

            </div>

            <div style="text-align:right;">

                <b>
                    @transaction.Date.ToString("dd.MM.yyyy")
                </b>

                <br />

                <small style="color:gray;">
                    @transaction.Type
                </small>

            </div>

        </div>
    }
}

@code {

    private List<TransactionDto>? transactions;

    protected override async Task OnInitializedAsync()
    {
        transactions =
            await Http.GetFromJsonAsync<List<TransactionDto>>(
                "http://localhost:5228/transactions");
    }

    private decimal TotalIncome =>
        transactions?
            .Where(t => t.Type == "Income")
            .Sum(t => t.Amount)
        ?? 0;

    private decimal TotalExpense =>
        transactions?
            .Where(t => t.Type == "Expense")
            .Sum(t => t.Amount)
        ?? 0;

    private decimal Balance =>
        TotalIncome - TotalExpense;

    private List<TransactionDto> RecentTransactions =>
        transactions?
            .OrderByDescending(t => t.Date)
            .Take(5)
            .ToList()

        ?? new();

    private List<CategorySummary> ExpenseByCategory
    {
        get
        {
            var expenseTransactions =
                transactions?
                    .Where(t => t.Type == "Expense")
                    .ToList()
                ?? new();

            var totalExpense =
                expenseTransactions.Sum(t => t.Amount);

            return expenseTransactions
                .GroupBy(t => t.CategoryName)
                .Select(g => new CategorySummary
                {
                    Category = g.Key,
                    Total = g.Sum(x => x.Amount),
                    Percent = totalExpense == 0
                        ? 0
                        : Math.Round(
                            g.Sum(x => x.Amount)
                            / totalExpense * 100, 1)
                })
                .ToList();
        }
    }

    private List<MonthlySummary> MonthlyStatistics =>
        transactions?
            .GroupBy(t =>
                t.Date.ToString(
                    "MMMM",
                    new CultureInfo("en-US")))
            .Select(g => new MonthlySummary
            {
                Month = g.Key,

                Income = g
                    .Where(x => x.Type == "Income")
                    .Sum(x => x.Amount),

                Expense = g
                    .Where(x => x.Type == "Expense")
                    .Sum(x => x.Amount)
            })
            .Select(x =>
            {
                x.Percent =
                    TotalIncome == 0
                        ? 0
                        : (x.Income / TotalIncome) * 100;

                return x;
            })
            .ToList()

        ?? new();

    public class MonthlySummary
    {
        public string Month { get; set; } = "";

        public decimal Income { get; set; }

        public decimal Expense { get; set; }

        public decimal Percent { get; set; }
    }

    public class CategorySummary
    {
        public string Category { get; set; } = "";

        public decimal Total { get; set; }

        public decimal Percent { get; set; }
    }

    public class TransactionDto
    {
        public Guid Id { get; set; }

        public decimal Amount { get; set; }

        public string Description { get; set; } = "";

        public string Type { get; set; } = "";

        public DateTime Date { get; set; }

        public string CategoryName { get; set; } = "";
    }
}